# Adfix — Üretim ortamı değişkenleri
# Bu dosyayı /home/sagunmed/SagunMedBeta/Adfix/backend/.env olarak kopyala
# chmod 600 .env

# JWT anahtarı — aşağıdaki komutu çalıştırıp sonucu yapıştır:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ADFIX_JWT_SECRET=__BURAYA_GUCLU_ANAHTAR__

# Port (varsayılan 8002, nginx arkasında değiştirme)
ADFIX_PORT=8002

# İlk kullanıcı şifresi (sadece DB yokken geçerli)
ADFIX_ILK_SIFRE=adfix2026
